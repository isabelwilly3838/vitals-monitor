# Production (container). Secrets MUST be injected via env vars or *_FILE docker secrets:
#   JWT_SECRETS / JWT_SECRETS_FILE, ENCRYPTION_KEYS / ENCRYPTION_KEYS_FILE, USERS_JSON / USERS_JSON_FILE
# The app refuses to start if they are missing or weak.
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true
SIMULATOR_ENABLED=true
SIMULATOR_HZ=1
SERVE_FRONTEND=false
DOCS_ENABLED=false
DATABASE_PATH=/data/vitals.db
JWT_TTL_MINUTES=15
LOGIN_RATE_PER_MINUTE=10
