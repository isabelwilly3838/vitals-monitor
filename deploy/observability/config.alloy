// Ship JSON logs of every container labelled logging=vitals to Loki.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["logging=vitals"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "vitals" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.json.receiver]
}

// Backend logs are Bunyan JSON (numeric level: 30 info, 40 warn, 50 error, 60 fatal).
loki.process "json" {
  stage.json {
    expressions = { level = "level" }
  }
  stage.template {
    source   = "level"
    template = "{{ if eq .Value \"30\" }}info{{ else if eq .Value \"40\" }}warning{{ else if eq .Value \"50\" }}error{{ else if eq .Value \"60\" }}critical{{ else if eq .Value \"20\" }}debug{{ else }}{{ .Value }}{{ end }}"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
