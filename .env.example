# Copy to .env for local overrides (git-ignored), or export in your shell.
# Any setting:  APP_<SECTION>__<KEY>=value      e.g. APP_SIMULATOR__HZ=2
# From a file:  APP_<SECTION>__<KEY>_FILE=path  e.g. APP_DATABASE__PASSWORD_FILE=/run/secrets/db
# APP_ENVIRONMENT=dev
# RUST_LOG=debug
# APP_SECURITY__JWT_SECRETS=new-secret,old-secret      # first signs, all verify
# APP_SECURITY__ENCRYPTION_KEYS=<base64-32B>,<old>     # first encrypts, all decrypt
