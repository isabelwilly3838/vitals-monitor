# Copy to .env for local overrides (git-ignored). Every setting can also be given as
# NAME_FILE=/path/to/secret (Docker/K8s secrets). See backend/app/config.py.
# APP_ENV=dev
# LOG_LEVEL=DEBUG
# SIMULATOR_HZ=2
# JWT_SECRETS=new-secret,old-secret          # first signs, all verify
# ENCRYPTION_KEYS=<fernet-key>,<old-key>     # first encrypts, all decrypt
