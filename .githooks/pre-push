#!/usr/bin/env sh
# Full test suite before pushing (needs Postgres: `make db`).
set -e
# find cargo even when rustup is keg-only (Homebrew) or not on the GUI app PATH
export PATH="$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:/usr/local/opt/rustup/bin:$PATH"
cd "$(git rev-parse --show-toplevel)/backend"
cargo test --quiet
